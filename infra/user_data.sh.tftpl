#!/bin/bash
set -eux

# Rendered by Terraform's templatefile(): $${app_domain} and $${certbot_email}
# are substituted at plan time. Shell expansions like $${var} must be escaped
# as double-dollar in this file.

# --- Docker engine ---
dnf update -y
dnf install -y docker
systemctl enable --now docker
usermod -aG docker ec2-user

# --- Docker Compose v2 (CLI plugin) ---
mkdir -p /usr/local/lib/docker/cli-plugins
curl -SL https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64 \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# --- 1 GiB swapfile (ADR-003, resized in ADR-006) ---
# The t3.micro box has 916 MiB and no swap by default. With Postgres and now
# the FusionAuth JVM (ADR-006) on the box, a memory spike would otherwise go
# straight to the OOM killer — and FusionAuth is expected to lean on this swap
# in steady state. Second layer of defense alongside the containers'
# compose-level mem_limits; bumped 512 MiB -> 1 GiB when FusionAuth joined.
dd if=/dev/zero of=/swapfile bs=1M count=1024
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile
echo '/swapfile none swap defaults 0 0' >>/etc/fstab

# --- Shared docker network (ADR-003) ---
# Private path between simulationAPI and simulationDB; both compose files
# declare it `external`. deploy.yml also creates it idempotently, covering
# boxes that predate this script.
docker network create simulation-net || true

# --- Weekly Postgres backups to S3 (ADR-003; fusionauth db added in ADR-006) ---
# The named volume survives redeploys but not a box rebuild — these dumps are
# the durability story. Restore drill is ADR-004. AL2023 ships no cron daemon.
dnf install -y cronie
systemctl enable --now crond

cat >/usr/local/bin/simulationdb-backup.sh <<'EOF'
#!/bin/bash
set -euo pipefail

# Credentials come from the .env the deploy pipeline writes next to
# simulationDB's compose file. Absent .env means the container hasn't been
# deployed yet — nothing to back up, not an error.
ENV_FILE=/home/ec2-user/containers/simulationDB/.env
if [ ! -f "$ENV_FILE" ]; then
  echo "$(date -Is) no simulationDB .env; skipping backup"
  exit 0
fi
. "$ENV_FILE"

# Both databases on the shared Postgres: the simulation app data (ADR-003) and
# FusionAuth's own database (ADR-006). Each dumps to its own bucket prefix —
# the instance role is write-only per prefix. Dumps run as $POSTGRES_USER, the
# dbadmin superuser (ADR-008) — the only role that can reach both databases.
# fusionauth may not exist yet on a box that predates ADR-008's first-boot
# script — skipping it is not an error.
for db in "$POSTGRES_DB" fusionauth; do
  if [ "$(docker exec simulationdb psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tAc \
        "SELECT 1 FROM pg_database WHERE datname = '$db'")" != "1" ]; then
    echo "$(date -Is) database $db does not exist; skipping"
    continue
  fi
  if [ "$db" = fusionauth ]; then prefix=fusionauth; else prefix=simulationdb; fi
  docker exec simulationdb pg_dump -U "$POSTGRES_USER" "$db" \
    | gzip \
    | aws s3 cp - "s3://${backup_bucket}/$prefix/$(date +%F).sql.gz"
  echo "$(date -Is) $db backup uploaded"
done
EOF
chmod +x /usr/local/bin/simulationdb-backup.sh

cat >/etc/cron.d/simulationdb-backup <<'EOF'
10 3 * * 0 root /usr/local/bin/simulationdb-backup.sh >>/var/log/simulationdb-backup.log 2>&1
EOF

# --- Post-quantum SSH key exchange ---
# AL2023 ships OpenSSH 8.7, which supports the sntrup761x25519 hybrid KEX but
# doesn't enable it by default. Prefer it so clients don't fall back to a
# classical-only exchange (avoids the "not using a post-quantum key exchange"
# warning and store-now-decrypt-later exposure). mlkem768 would need OpenSSH 9.9+.
cat >/etc/ssh/sshd_config.d/50-pq-kex.conf <<'EOF'
KexAlgorithms sntrup761x25519-sha512@openssh.com,curve25519-sha256,curve25519-sha256@libssh.org,ecdh-sha2-nistp256,ecdh-sha2-nistp384,ecdh-sha2-nistp521,diffie-hellman-group-exchange-sha256,diffie-hellman-group14-sha256,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512
EOF
sshd -t && systemctl restart sshd

# --- Root dir the deploy pipeline syncs per-container subdirs into ---
mkdir -p /home/ec2-user/containers
chown ec2-user:ec2-user /home/ec2-user/containers

# --- Nginx reverse proxy + Let's Encrypt (ADR-001) ---
# simulationWeb (127.0.0.1:8080) and simulationAPI (127.0.0.1:3003) bind to
# loopback only; nginx terminates TLS on 443 and routes by hostname, so
# exposing a future container is one more server block on its own subdomain.
dnf install -y nginx certbot python3-certbot-nginx

# Per-client-IP rate limiting, enforced at the proxy so a flood never reaches
# the containers. Each 10m zone tracks ~160k addresses. limit_req is applied
# per vhost below; requests over the burst get 429 (default would be 503,
# which reads as an outage).
cat >/etc/nginx/conf.d/00-ratelimit.conf <<'EOF'
limit_req_zone $binary_remote_addr zone=web_perip:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=api_perip:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=auth_perip:10m rate=30r/s;
limit_req_status 429;
EOF

# HTTP-only vhosts to start. certbot --nginx rewrites them below: adds the 443
# TLS server blocks and the 80 -> 443 redirects.
#
# The app vhost is gated behind FusionAuth (ADR-007): simulationAPI on :3003
# doubles as the OIDC relying party. nginx auth_request asks it (GET
# /auth/verify) whether the request carries a valid session cookie on every
# hit; a 401 bounces the browser to /auth/login, which simulationAPI proxies
# and which starts the login flow at id.makejohnacoffee.com. Only the static
# SPA on :8080 is gated — the /auth/ endpoints must stay reachable to log in.
cat >/etc/nginx/conf.d/${app_domain}.conf <<'EOF'
server {
    listen 80;
    server_name ${app_domain};

    # OIDC endpoints (login/callback/verify/me/logout) — never gated, or
    # there'd be no way to authenticate. Proxied to simulationAPI.
    location /auth/ {
        limit_req zone=auth_perip burst=60 nodelay;
        proxy_pass http://127.0.0.1:3003;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        # Login wall: simulationAPI validates the session cookie and returns
        # 200 (serve the SPA) or 401 (redirect to log in). The subrequest
        # carries the original cookies; no body is forwarded.
        auth_request /auth/verify;
        error_page 401 = @signin;

        limit_req zone=web_perip burst=60 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location @signin {
        return 302 /auth/login?rd=$request_uri;
    }
}
EOF

cat >/etc/nginx/conf.d/${api_domain}.conf <<'EOF'
server {
    listen 80;
    server_name ${api_domain};

    location / {
        limit_req zone=api_perip burst=20 nodelay;
        proxy_pass http://127.0.0.1:3003;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
EOF

# FusionAuth (ADR-006): loopback container on :9011, exposed on its own
# subdomain. client_max_body_size is bumped from nginx's 1m default so admin
# uploads (themes, config imports) aren't truncated.
cat >/etc/nginx/conf.d/${auth_domain}.conf <<'EOF'
server {
    listen 80;
    server_name ${auth_domain};

    client_max_body_size 64m;

    location / {
        limit_req zone=auth_perip burst=60 nodelay;
        proxy_pass http://127.0.0.1:9011;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
EOF
nginx -t
systemctl enable --now nginx

# Reload nginx whenever certbot deploys a renewed certificate.
mkdir -p /etc/letsencrypt/renewal-hooks/deploy
cat >/etc/letsencrypt/renewal-hooks/deploy/reload-nginx.sh <<'EOF'
#!/bin/bash
systemctl reload nginx
EOF
chmod +x /etc/letsencrypt/renewal-hooks/deploy/reload-nginx.sh

# One certificate per subdomain, so each can be renewed/revoked independently.
# At first boot the Elastic IP (where DNS points) may not be attached yet, so
# the HTTP-01 challenge can land on the wrong box — retry until the EIP is on
# (usually the first or second attempt succeeds).
for domain in "${app_domain}" "${api_domain}" "${auth_domain}"; do
  for attempt in $(seq 1 40); do
    if certbot --nginx -d "$domain" --non-interactive --agree-tos \
         -m "${certbot_email}" --redirect; then
      break
    fi
    echo "certbot attempt $attempt for $domain failed; retrying in 30s"
    sleep 30
  done
done

# The certbot RPM ships a systemd timer that runs `certbot renew` twice a day.
systemctl enable --now certbot-renew.timer
