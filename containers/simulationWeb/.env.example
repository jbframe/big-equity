# Copy to .env.local for personal overrides (gitignored).
#
# Origin of the simulationAPI data routes. Vite envs are baked in at BUILD
# time, not read at runtime.
#
#   local stack:  http://local.api.makejohnacoffee.com (the committed
#                 .env.development default for `npm run dev`)
#   prod:         https://api.makejohnacoffee.com (baked by the Dockerfile's
#                 VITE_API_BASE_URL build ARG)
#   unset:        same-origin relative URLs — these hit the gateway, where
#                 authed data routes won't work (you get the SPA back).
VITE_API_BASE_URL=http://local.api.makejohnacoffee.com
